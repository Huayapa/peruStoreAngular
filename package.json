{
  "name": "peru-store-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "ng lint",
    "format": "prettier --write \"./src/**/*.{ts,json,html}\"",
    "prepare": "husky",
    "e2e": "ng e2e"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@angular/cdk": "21.2.8",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "21.2.8",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@stripe/stripe-js": "9.5.0",
    "@vercel/analytics": "2.0.1",
    "jwt-decode": "4.0.0",
    "lottie-web": "5.13.0",
    "ngx-lottie": "21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.5",
    "@angular/cli": "^21.1.5",
    "@angular/compiler-cli": "^21.1.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "30.4.1",
    "@playwright/test": "1.60.0",
    "@testing-library/angular": "19.4.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "angular-eslint": "21.3.1",
    "eslint": "^10.0.3",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "16.1.5",
    "jsdom": "^27.1.0",
    "lint-staged": "16.4.0",
    "playwright-ng-schematics": "^21.1.0",
    "prettier": "3.8.3",
    "testing-library": "0.0.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1"
  }
}
